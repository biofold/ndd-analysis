#!/bin/bash

# Usage: ./script.sh <complete_genes.tsv> <cancer_genes.txt> <mondo_genes.txt>

if [ $# -ne 3 ]; then
    echo "Usage: $0 <complete_genes.tsv> <cancer_genes.txt> <mondo_genes.txt>"
    echo ""
    echo "Arguments:"
    echo "  complete_genes.tsv  - File with header and columns: gene, classification"
    echo "                        classification: curated, candidate, or no_evidence"
    echo "  cancer_genes.txt    - List of cancer genes (can have multiple columns, first column = gene ID)"
    echo "  mondo_genes.txt     - List of MONDO genes (can have multiple columns, first column = gene ID)"
    echo ""
    echo "Note: Lines starting with # are treated as comments and skipped"
    exit 1
fi

COMPLETE_GENES="$1"
CANCER_GENES="$2"
MONDO_GENES="$3"

# Check if files exist
for file in "$COMPLETE_GENES" "$CANCER_GENES" "$MONDO_GENES"; do
    if [ ! -f "$file" ]; then
        echo "Error: File not found: $file"
        exit 1
    fi
done

# Process everything with awk
awk -F '\t' -v cancer_file="$CANCER_GENES" -v mondo_file="$MONDO_GENES" '
function format_number(n) {
    # Add commas to numbers for thousands
    if (n >= 1000000) {
        return sprintf("%d,%03d,%03d", int(n/1000000), int((n%1000000)/1000), n%1000)
    } else if (n >= 1000) {
        return sprintf("%d,%03d", int(n/1000), n%1000)
    }
    return sprintf("%d", n)
}

function is_comment(line) {
    # Check if line starts with # (optionally after whitespace)
    return (line ~ /^[[:space:]]*#/)
}

BEGIN {
    # Read cancer genes (first column only)
    while ((getline line < cancer_file) > 0) {
        # Skip comments and empty lines
        if (!is_comment(line) && line != "") {
            # Split by tab to get first column
            split(line, fields, "\t")
            gene = fields[1]
            
            # Remove any leading/trailing whitespace
            gsub(/^[[:space:]]+/, "", gene)
            gsub(/[[:space:]]+$/, "", gene)
            
            if (gene != "") {
                cancer_genes[gene] = 1
            }
        }
    }
    close(cancer_file)

    # Read MONDO genes (first column only)
    while ((getline line < mondo_file) > 0) {
        # Skip comments and empty lines
        if (!is_comment(line) && line != "") {
            # Split by tab to get first column
            split(line, fields, "\t")
            gene = fields[1]
            
            # Remove any leading/trailing whitespace
            gsub(/^[[:space:]]+/, "", gene)
            gsub(/[[:space:]]+$/, "", gene)
            
            if (gene != "") {
                mondo_genes[gene] = 1
            }
        }
    }
    close(mondo_file)

    # Initialize counters
    # Format: count[classification][gene_type]
    count["curated", "mondo"] = 0
    count["curated", "cancer"] = 0
    count["curated", "total"] = 0

    count["candidate", "mondo"] = 0
    count["candidate", "cancer"] = 0
    count["candidate", "total"] = 0

    count["no_evidence", "mondo"] = 0
    count["no_evidence", "cancer"] = 0
    count["no_evidence", "total"] = 0

    # Totals
    total_mondo = 0
    for (gene in mondo_genes) total_mondo++
    
    total_cancer = 0
    for (gene in cancer_genes) total_cancer++

    total_all = 0
    
    # Flag to track if header has been seen
    header_seen = 0
}

# Process complete genes file
{
    # Skip comments and empty lines
    if (is_comment($0) || $0 == "") {
        next
    }
    
    # Skip header (first non-comment line)
    if (!header_seen) {
        header_seen = 1
        next
    }

    gene = $1
    classification = $2

    # Skip if gene or classification is empty
    if (gene == "" || classification == "") {
        next
    }

    # Only process known classifications
    if (classification == "curated" || classification == "candidate" || classification == "no_evidence") {
        count[classification, "total"]++
        total_all++

        if (gene in cancer_genes) {
            count[classification, "cancer"]++
        }

        if (gene in mondo_genes) {
            count[classification, "mondo"]++
        }
    }
}

END {
    # Print header
    printf "%-15s\t%-25s\t%-25s\t%-25s\t%-25s\n", "Genes", "curated", "candidate", "no_evidence", "Total"
    printf "%-15s\t%-25s\t%-25s\t%-25s\t%-25s\n", "-----", "-------", "---------", "-----------", "-----"

    # Print MONDO row
    mondo_curated_pct = (count["curated", "total"] > 0) ? (count["curated", "mondo"] / count["curated", "total"]) * 100 : 0
    mondo_candidate_pct = (count["candidate", "total"] > 0) ? (count["candidate", "mondo"] / count["candidate", "total"]) * 100 : 0
    mondo_no_evidence_pct = (count["no_evidence", "total"] > 0) ? (count["no_evidence", "mondo"] / count["no_evidence", "total"]) * 100 : 0
    mondo_total_pct = (total_all > 0) ? (total_mondo / total_all) * 100 : 0

    printf "%-15s\t%-25s\t%-25s\t%-25s\t%-25s\n", 
        "MONDO Genes",
        sprintf("%s (%.1f%%)", format_number(count["curated", "mondo"]), mondo_curated_pct),
        sprintf("%s (%.1f%%)", format_number(count["candidate", "mondo"]), mondo_candidate_pct),
        sprintf("%s (%.1f%%)", format_number(count["no_evidence", "mondo"]), mondo_no_evidence_pct),
        sprintf("%s (%.1f%%)", format_number(total_mondo), mondo_total_pct)

    # Print Cancer row
    cancer_curated_pct = (count["curated", "total"] > 0) ? (count["curated", "cancer"] / count["curated", "total"]) * 100 : 0
    cancer_candidate_pct = (count["candidate", "total"] > 0) ? (count["candidate", "cancer"] / count["candidate", "total"]) * 100 : 0
    cancer_no_evidence_pct = (count["no_evidence", "total"] > 0) ? (count["no_evidence", "cancer"] / count["no_evidence", "total"]) * 100 : 0
    cancer_total_pct = (total_all > 0) ? (total_cancer / total_all) * 100 : 0

    printf "%-15s\t%-25s\t%-25s\t%-25s\t%-25s\n", 
        "Cancer Genes",
        sprintf("%s (%.1f%%)", format_number(count["curated", "cancer"]), cancer_curated_pct),
        sprintf("%s (%.1f%%)", format_number(count["candidate", "cancer"]), cancer_candidate_pct),
        sprintf("%s (%.1f%%)", format_number(count["no_evidence", "cancer"]), cancer_no_evidence_pct),
        sprintf("%s (%.1f%%)", format_number(total_cancer), cancer_total_pct)

    # Print Total row
    printf "%-15s\t%-25s\t%-25s\t%-25s\t%-25s\n", 
        "Total",
        sprintf("%s (100.0%%)", format_number(count["curated", "total"])),
        sprintf("%s (100.0%%)", format_number(count["candidate", "total"])),
        sprintf("%s (100.0%%)", format_number(count["no_evidence", "total"])),
        sprintf("%s (100.0%%)", format_number(total_all))
}
' "$COMPLETE_GENES"
